{
  "name": "jellyfin-enhanced",
  "version": "0.0.0",
  "private": true,
  "description": "Development tooling for the Jellyfin Enhanced plugin (lint, type-check, translation validation). The plugin itself ships as embedded resources from the C# project.",
  "scripts": {
    "lint": "eslint \"Jellyfin.Plugin.JellyfinEnhanced/js/**/*.js\" \"Jellyfin.Plugin.JellyfinEnhanced/Configuration/*.js\" \"scripts/**/*.js\" \"tests/e2e/**/*.js\" playwright.config.js",
    "lint:fix": "eslint --fix \"Jellyfin.Plugin.JellyfinEnhanced/js/**/*.js\" \"Jellyfin.Plugin.JellyfinEnhanced/Configuration/*.js\" \"scripts/**/*.js\" \"tests/e2e/**/*.js\" playwright.config.js",
    "architecture": "node scripts/check-architecture.js",
    "typecheck": "tsc -p jsconfig.json",
    "syntax": "node scripts/check-syntax.js",
    "build:bundle": "node scripts/build-bundle.js",
    "validate-translations": "node scripts/validate-translations.js validate",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.1",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3"
  }
}
