<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
    <!-- Every feature settings partial and host configuration source: a new settings file is covered automatically. -->
    <Compile Include="../../../../src/host/configuration/*.cs" LinkBase="Production" />
    <Compile Include="../../../../src/features/*/settings/*.cs" LinkBase="Production" />
    <Compile Include="../../../../src/features/arr/server/ArrInstance.cs" Link="Production/ArrInstance.cs" />
    <Compile Include="../../../../src/features/analytics/server/AnalyticsData.cs" Link="Production/AnalyticsData.cs" />
    <Compile Include="../../../../src/shared/persistence/UserConfigurationManager.cs" Link="Production/UserConfigurationManager.cs" />
    <Compile Include="../../../../src/features/reviews/server/UserConfigurationManager.Reviews.cs" Link="Production/UserConfigurationManager.Reviews.cs" />
    <Compile Include="../../../../src/features/activity/server/UserConfigurationManager.Activity.cs" Link="Production/UserConfigurationManager.Activity.cs" />
    <Compile Include="../../../../src/features/seerr/server/UserConfigurationManager.Seerr.cs" Link="Production/UserConfigurationManager.Seerr.cs" />
    <Compile Include="../../../../src/features/seerr/server/ProcessedWatchlistStore.cs" Link="Production/ProcessedWatchlistStore.cs" />
    <Compile Include="../../../../src/features/activity/server/ActivityStore.cs" Link="Production/ActivityStore.cs" />
    <Compile Include="../../../../src/features/reviews/server/ReviewStore.cs" Link="Production/ReviewStore.cs" />
    <None Include="schema-defaults.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('schema-defaults.json')" />
    <None Include="plugin-defaults.xml" CopyToOutputDirectory="PreserveNewest" Condition="Exists('plugin-defaults.xml')" />
  </ItemGroup>
</Project>
